# Puerto de la aplicación
PORT=3000

# Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=tu_anon_key_aqui
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key_aqui
SUPABASE_JWT_SECRET=tu_jwt_secret_aqui

# Base de datos PostgreSQL (obligatoria en producción)
# En Vercel/serverless usa el pooler de Supabase (puerto 6543) para no agotar conexiones.
DATABASE_URL=postgresql://postgres:tu_password@db.tu_proyecto.supabase.co:5432/postgres
SUPABASE_DATABASE_URL=postgresql://postgres:tu_password@db.tu_proyecto.supabase.co:5432/postgres
# Máximo de conexiones por instancia (default: 3 en Vercel, 10 fuera de Vercel).
PG_POOL_MAX=3
# TLS: por defecto se verifica el certificado usando el CA público de Supabase
# incluido en certs/supabase-prod-ca-2021.crt. Puedes sobrescribirlo con otro
# PEM o con la ruta a un archivo (opcional).
DB_SSL_CA=
# Solo para entornos sin CA disponible (inseguro, no recomendado):
# DB_SSL_REJECT_UNAUTHORIZED=false

# Mercado Pago
MERCADOPAGO_ACCESS_TOKEN=tu_access_token_aqui
# URL pública con la que se construyen los enlaces de retorno de pago.
# Obligatoria en producción: nunca se usa el header Host del cliente.
CLIENT_URL=https://tu-dominio.com
# URL del webhook de Mercado Pago si usas una instancia remota (opcional)
WEBHOOK_URL=https://tu-dominio.com/api/webhook/mercadopago
# Secreto para validar X-Signature del webhook de MP (Dashboard → Webhooks).
# Obligatorio: si está vacío, el webhook rechaza las notificaciones (fail-closed).
MERCADOPAGO_WEBHOOK_SECRET=

# Seguridad / JWT
# JWT_SECRET y QR_SECRET son OBLIGATORIOS, deben ser distintos entre sí y
# tener al menos 32 caracteres. Genera cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=tu_jwt_secret_aqui
SESSION_SECRET=tu_session_secret_aqui
# Clave independiente para firmar los códigos QR de las entradas.
QR_SECRET=tu_qr_secret_aqui

# Secreto para autenticar el cron de limpieza de Vercel (Authorization: Bearer ...).
# Vercel Cron lo envía automáticamente si defines CRON_SECRET en el proyecto.
CRON_SECRET=tu_cron_secret_aqui

# Resend (envío de códigos y QRs)
RESEND_API_KEY=tu_resend_api_key_aqui
RESEND_FROM=Vive Ticket <contacto@tu-dominio.com>

# SMTP (si lo usas)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_password_de_aplicacion
SMTP_FROM=tu_email@gmail.com